# Copy to .env (next to the compose file you use).

# Required. The address of your Grocy. People sign in to Grocy Assistant with
# their Grocy username and password, and this is the only place those are sent.
# It must be reachable from inside the container (not "localhost" unless Grocy
# shares its network).
GA_GROCY_URL=

# Optional. Encrypts the stored Grocy and AI API keys. If unset, a random key is
# generated and kept in the data volume (data/secret.key), which is fine for
# most setups.
GA_SECRET_KEY=
